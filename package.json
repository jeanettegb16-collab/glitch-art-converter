{
  "name": "glitch-art-converter",
  "version": "1.0.0",
  "description": "Browser-based glitch art / ASCII / pixel art converter with custom WebM, GIF, APNG, and ZIP encoders",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "glitch",
    "ascii",
    "pixel-art",
    "webm",
    "gif",
    "apng",
    "typescript"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.14.0",
    "jsdom": "^30.1.3",
    "typescript": "^5.4.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
